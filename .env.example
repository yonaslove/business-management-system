# ==============================================================================
# Business Management System - Environment Configuration Template
# Copy this file to .env and adjust values for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=bms_user
POSTGRES_PASSWORD=your_strong_production_db_password
POSTGRES_DB=bms_db
POSTGRES_PORT=5432

# Backend Database Connection String
# Inside Docker Compose: postgresql://bms_user:your_strong_production_db_password@db:5432/bms_db
# Local host / External: postgresql://bms_user:your_strong_production_db_password@localhost:5432/bms_db
DATABASE_URL=postgresql://bms_user:your_strong_production_db_password@localhost:5432/bms_db

# Security & JWT Tokens (Generate a 64+ char random string for production)
SECRET_KEY=change-this-to-a-secure-random-64-character-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Metadata
PROJECT_NAME=Business Management System

# Frontend Public API URL
# For local development: http://localhost:8000/api
# For production: https://api.yourdomain.com/api or https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
